venv/
**/venv/
__pycache__/
*.pyc

# Capture files — never commit pcap data
*.pcap
*.pcapng

# Dev-repo legacy output/pcaps dirs (parent of src/)
otscope/output/
otscope/pcaps/

# Field-deployment workspace dirs (siblings of otscope.py in src/)
# Ignore content but track the .gitkeep so the folders exist in a fresh clone/zip.
otscope/src/pcaps/*
!otscope/src/pcaps/.gitkeep
otscope/src/output/*
!otscope/src/output/.gitkeep

# Release packages — built by build_release.py, never committed
dist/

.claude/
notes/
